{
  "name": "@coratch/agent-session-viewer",
  "version": "0.2.1",
  "description": "Local session replay and recap viewer for Claude Code and Codex JSONL logs.",
  "license": "MIT",
  "private": false,
  "author": "Coratch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coratch/agent-session-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/Coratch/agent-session-viewer/issues"
  },
  "homepage": "https://github.com/Coratch/agent-session-viewer#readme",
  "keywords": [
    "agent",
    "agent-session",
    "ai-coding",
    "claude-code",
    "claude-code-session",
    "claude-session-viewer",
    "codex",
    "codex-cli",
    "codex-session-viewer",
    "developer-tools",
    "jsonl",
    "jsonl-viewer",
    "local-first",
    "observability",
    "recap",
    "session-replay",
    "session-viewer",
    "tool-calls"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agent-session-viewer": "bin/agent-session-viewer.js"
  },
  "scripts": {
    "check": "node --check bin/agent-session-viewer.js && node --check src/cli.js && node --check src/server.js && node --check src/recap.js && node --check src/redaction.js && node --check public/app.js && node scripts/scan-sensitive.js",
    "pack:check": "npm pack --dry-run",
    "start": "node src/cli.js",
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "docs/assets/",
    "docs/demo.md",
    "examples/fixtures/",
    "src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {}
}
